# Explicitly select d1 or supabase. Payment mode stays separate.
STORAGE_BACKEND=d1
# Native Next production only: exact public origin, no trailing slash.
APP_ORIGIN=
# Server-only Supabase credentials. Apply all migrations before selecting supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only. Not used by isolated demo.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_INTENTS_API_KEY=
# Protected server reconciliation endpoint (demo expiry and real provider checks).
CRON_SECRET=

# Leave false until real wallet/refund/settlement acceptance is completed.
# Configuring a key alone never enables funded payment requests.
LIVE_PAYMENTS_ENABLED=false
LIVE_ZCASH_ENABLED=false
ZCASH_ACCEPTANCE_VERIFIED=false
LIVE_CONFIDENTIAL_ENABLED=false
CONFIDENTIAL_ACCEPTANCE_VERIFIED=false

# Solana mainnet USDC only; verify wallet handoff, SOL fees, refunds and confidential credit.
LIVE_SOLANA_ENABLED=false
SOLANA_ACCEPTANCE_VERIFIED=false

# Explicit owner-only pilot; does not assert funded acceptance has passed.
LIVE_PAYMENT_TESTING=false
# Public real-funds pilot; also disable STANDALONE_PRIVATE_ACCESS.
PUBLIC_LIVE_PILOT=false
# Requires migration 008 (Supabase) or the equivalent D1 migration.
RECEIPT_CLEANUP_ENABLED=false
# Sites only: requires owner-private platform access and authenticated identity.
PRIVATE_LIVE_TEST_HOST=false
# Native standalone only: signed owner-session login; generate a strong secret.
STANDALONE_PRIVATE_ACCESS=false
PRIVATE_TEST_PASSWORD=
